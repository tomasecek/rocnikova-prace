#define STEP_PIN 18
#define DIR_PIN 19
#define ENABLE_PIN 21

int stepsPerRevolution = 400;

void setup() {
  Serial.begin(115200);

  pinMode(STEP_PIN, OUTPUT);
  pinMode(DIR_PIN, OUTPUT);
  pinMode(ENABLE_PIN, OUTPUT);

  digitalWrite(ENABLE_PIN, LOW); // zapnutí driveru
  Serial.println("Test krokoveho motoru startuje");
}

void loop() {
  // Otaceni doprava
  Serial.println("Motor se otaci doprava");
  digitalWrite(DIR_PIN, HIGH);
  stepMotor(stepsPerRevolution);

  delay(2000);

  // Otaceni doleva
  Serial.println("Motor se otaci doleva");
  digitalWrite(DIR_PIN, LOW);
  stepMotor(stepsPerRevolution);

  delay(2000);
}

void stepMotor(int steps) {
  for (int i = 0; i < steps; i++) {
    digitalWrite(STEP_PIN, HIGH);
    delayMicroseconds(1000);
    digitalWrite(STEP_PIN, LOW);
    delayMicroseconds(1000);
  }
}
